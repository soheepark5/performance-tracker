{
  "name": "capacity",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Personal capacity tracker: Body, Brain, Immersion (Sep 2026 - Dec 2028)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "build:artifact": "npm run build:single && node build-artifact.mjs",
    "icons": "node scripts/make-icons.mjs",
    "share": "node scripts/make-share.mjs",
    "test:sync": "node ./node_modules/esbuild/bin/esbuild scripts/sync.test.ts --bundle --platform=node --format=esm --define:import.meta.env={} --outfile=.sync-test.mjs --log-level=error && node .sync-test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
